---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE, link, fmtDate } from '../consts';
import { RESEARCH, PROJECTS } from '../data/research';
import { HERO_PHOTOS } from '../data/photos';
import PhotoStack from '../components/PhotoStack.astro';

const publications = await getCollection('publications');
const latestPubs = [...publications]
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);

const newsItems = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const stats = [
  { value: String(RESEARCH.length), label: '研究方向' },
  { value: String(PROJECTS.length), label: '在研项目' },
  { value: `${publications.length}`, label: '收录论文' },
  { value: '3', label: '国家自然科学基金面上项目' },
];
---

<Layout>
  <!-- ========== Hero ========== -->
  <section class="relative overflow-hidden border-b border-cau-line bg-white">
    <div
      class="pointer-events-none absolute -top-32 -right-24 h-80 w-80 rounded-full bg-cau-light opacity-80 blur-3xl"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-5 py-20 md:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-12">
        <div>
          <span class="tag">{SITE.school} · {SITE.college}</span>

          <h1 class="mt-5 text-4xl leading-tight font-bold tracking-tight md:text-5xl">
            {SITE.name}
          </h1>

          <p class="mt-3 text-sm tracking-[0.2em] text-muted uppercase">{SITE.nameEn}</p>

          <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
            {SITE.intro}
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a href={link('join')} class="btn btn-primary">加入我们 →</a>
            <a href={link('research')} class="btn btn-ghost">了解研究方向</a>
          </div>

          <dl class="mt-14 grid max-w-xl grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
            {
              stats.map((s) => (
                <div>
                  <dt class="text-3xl font-bold text-cau">{s.value}</dt>
                  <dd class="mt-1 text-xs leading-snug text-muted">{s.label}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="lg:pl-4">
          <PhotoStack photos={HERO_PHOTOS} />
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 研究方向 ========== -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-cau uppercase">Research</p>
        <h2 class="mt-2 text-2xl font-bold md:text-3xl">研究方向</h2>
      </div>
      <a
        href={link('research')}
        class="text-sm font-semibold text-cau transition-all duration-300 ease-in-out hover:underline"
      >
        查看全部 →
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        RESEARCH.map((area) => (
          <a href={`${link('research')}#${area.id}`} class="card block">
            <h3 class="text-base font-bold text-ink">{area.title}</h3>
            <p class="mt-1 text-[11px] tracking-[0.12em] text-muted uppercase">{area.titleEn}</p>
            <p class="mt-4 text-[13.5px] leading-relaxed">{area.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ========== 最新论文 ========== -->
  <section class="border-y border-cau-line bg-page">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-cau uppercase">Publications</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">最新论文</h2>
        </div>
        <a
          href={link('publications')}
          class="text-sm font-semibold text-cau transition-all duration-300 ease-in-out hover:underline"
        >
          全部 {publications.length} 篇 →
        </a>
      </div>

      <ul class="mt-10 space-y-4">
        {
          latestPubs.map((p) => (
            <li class="pub-row">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
                <span class="tag">{p.data.journal}</span>
                <span class="font-semibold text-cau">{p.data.year}</span>
              </div>
              <h3 class="mt-2 text-[15px] leading-snug font-semibold text-ink">{p.data.title}</h3>
              <p class="mt-1.5 text-[13px] text-muted">{p.data.authors}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========== 新闻动态 ========== -->
  {
    newsItems.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 py-20">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold tracking-[0.18em] text-cau uppercase">News</p>
            <h2 class="mt-2 text-2xl font-bold md:text-3xl">新闻动态</h2>
          </div>
          <a
            href={link('news')}
            class="text-sm font-semibold text-cau transition-all duration-300 ease-in-out hover:underline"
          >
            更多动态 →
          </a>
        </div>

        <ul class="mt-10 space-y-4">
          {newsItems.map((n) => (
            <li class="card flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
              <time class="shrink-0 text-sm font-semibold text-cau" datetime={fmtDate(n.data.date)}>
                {fmtDate(n.data.date)}
              </time>
              <div class="min-w-0">
                <h3 class="text-[15px] font-semibold text-ink">{n.data.title}</h3>
                {n.data.summary && (
                  <p class="mt-1 text-[13.5px] leading-relaxed text-muted">{n.data.summary}</p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ========== 加入我们 ========== -->
  <section class="border-t border-cau-line bg-cau text-white">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
      <h2 class="text-2xl font-bold text-white md:text-3xl">欢迎加入我们</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-white/85">
        课题组长期招收博士、硕士研究生，也欢迎本科生进实验室做科研训练。如果你对媒介节肢动物生物学、寄生虫病防控或新型兽药制剂感兴趣，欢迎联系我们。
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={link('join')}
          class="btn bg-white text-cau transition-all duration-300 ease-in-out hover:scale-[1.02] hover:bg-cau-light"
        >
          查看招生信息
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="btn border border-white/60 text-white transition-all duration-300 ease-in-out hover:scale-[1.02] hover:bg-white/10"
        >
          {SITE.email}
        </a>
      </div>
    </div>
  </section>
</Layout>
