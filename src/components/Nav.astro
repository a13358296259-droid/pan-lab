---
import { SITE, NAV, link } from '../consts';

const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const current = norm(Astro.url.pathname);
const isCurrent = (path: string) => norm(link(path)) === current;
---

<header
  class="sticky top-0 z-50 border-b border-cau-line/70 bg-white/85 backdrop-blur-md supports-[backdrop-filter]:bg-white/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a
      href={link('')}
      class="flex items-center gap-3 transition-transform duration-300 ease-in-out hover:scale-[1.02]"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-cau text-[13px] font-bold tracking-wide text-white shadow-sm"
        >CAU</span
      >
      <span class="leading-tight">
        <span class="block text-[15px] font-bold text-ink">{SITE.name}</span>
        <span class="block text-[11px] tracking-[0.12em] text-muted uppercase">{SITE.nameEn}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={link(item.path)}
            class="nav-link"
            data-current={isCurrent(item.path) ? 'true' : 'false'}
            aria-current={isCurrent(item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-cau-line text-cau transition-all duration-300 ease-in-out hover:scale-[1.04] hover:bg-cau-light"
      >
        <span class="sr-only">打开导航菜单</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 w-48 overflow-hidden rounded-xl border border-cau-line bg-white py-1 shadow-xl"
        aria-label="手机导航"
      >
        {
          NAV.map((item) => (
            <a
              href={link(item.path)}
              class="block px-4 py-2.5 text-sm transition-colors duration-300 ease-in-out hover:bg-cau-light hover:text-cau"
              data-current={isCurrent(item.path) ? 'true' : 'false'}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
