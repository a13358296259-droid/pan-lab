---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'publications'>[];
  showTabs?: boolean;
}

const { items, showTabs = true } = Astro.props;

// 年份倒序；同一年内按期刊名排序，保证每次构建顺序稳定
const sorted = [...items].sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return `${a.data.journal}`.localeCompare(`${b.data.journal}`);
});

const years = [...new Set(sorted.map((p) => p.data.year))].sort((a, b) => b - a);
const countOf = (y: number) => sorted.filter((p) => p.data.year === y).length;
const hasBody = (e: CollectionEntry<'publications'>) => Boolean(e.body && e.body.trim());

// 把通讯作者 Pan B 加粗，方便一眼看到课题组署名
const highlightPi = (authors: string) =>
  authors.replace(/\bPan B\b/g, '<strong class="font-semibold text-ink">Pan B</strong>');

const rendered = await Promise.all(
  sorted.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

{
  showTabs && (
    <div class="flex flex-wrap gap-2" role="tablist" aria-label="按年份筛选论文">
      <button type="button" class="year-tab" data-year="all" aria-selected="true">
        全部<span class="tab-count">{sorted.length}</span>
      </button>
      {years.map((y) => (
        <button type="button" class="year-tab" data-year={String(y)} aria-selected="false">
          {y}
          <span class="tab-count">{countOf(y)}</span>
        </button>
      ))}
    </div>
  )
}

<ol id="pub-list" class="mt-8 space-y-4">
  {
    rendered.map(({ entry, Content }) => (
      <li class="pub-row" data-year={String(entry.data.year)}>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
          <span class="tag">{entry.data.journal}</span>
          <span class="font-semibold text-cau">{entry.data.year}</span>
        </div>

        <h3 class="mt-2 text-[15px] leading-snug font-semibold text-ink">{entry.data.title}</h3>

        <p class="mt-1.5 text-[13px] text-muted" set:html={highlightPi(entry.data.authors)} />

        {entry.data.doi && (
          <a
            href={`https://doi.org/${entry.data.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-[13px] text-cau transition-all duration-300 ease-in-out hover:underline"
          >
            DOI: {entry.data.doi} ↗
          </a>
        )}

        {hasBody(entry) && (
          <details class="mt-3">
            <summary class="cursor-pointer text-[13px] font-medium text-cau select-none">
              摘要 Abstract
            </summary>
            <div class="mt-2 border-l-2 border-cau-line pl-3 text-[13.5px] leading-relaxed text-body">
              <Content />
            </div>
          </details>
        )}
      </li>
    ))
  }
</ol>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.year-tab'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#pub-list .pub-row'));

  function apply(year: string) {
    for (const row of rows) {
      const match = year === 'all' || row.dataset.year === year;
      // 用 Tailwind 的 .hidden（utilities 层）来隐藏，优先级高于 .pub-row 自身样式
      row.classList.toggle('hidden', !match);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const t of tabs) t.setAttribute('aria-selected', String(t === tab));
      apply(tab.dataset.year ?? 'all');
    });
  }
</script>
